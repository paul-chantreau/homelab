{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/paul-chantreau/homelab/config/schema/network.schema.json",
  "title": "MAAS network configuration",
  "type": "object",
  "required": ["network"],
  "additionalProperties": false,
  "properties": {
    "network": {
      "type": "object",
      "required": ["management", "provisioning"],
      "additionalProperties": false,
      "properties": {
        "management": {
          "type": "object",
          "required": ["interface_mac", "address", "gateway", "dns", "vlan_id"],
          "additionalProperties": false,
          "properties": {
            "interface_mac": {"type": ["string", "null"]},
            "address": {"type": ["string", "null"]},
            "gateway": {"type": ["string", "null"]},
            "dns": {"type": "array", "items": {"type": "string"}},
            "vlan_id": {"type": "integer"}
          }
        },
        "provisioning": {
          "type": "object",
          "required": ["vlan_id", "subnet", "controller_address", "dhcp"],
          "additionalProperties": false,
          "properties": {
            "vlan_id": {"type": "integer"},
            "subnet": {"type": ["string", "null"]},
            "controller_address": {"type": ["string", "null"]},
            "dhcp": {
              "type": "object",
              "required": ["range_start", "range_end"],
              "additionalProperties": false,
              "properties": {
                "range_start": {"type": ["string", "null"]},
                "range_end": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
